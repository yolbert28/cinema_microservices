# ============================================================
# Auth Service — .dockerignore
# Excluye archivos innecesarios del build context de Docker
# ============================================================

# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
*.iml
*.iws

# Maven target (se compila dentro del contenedor)
target/

# Documentación
HELP.md
*.md

# Tests (se omiten en el build de producción con -DskipTests)
src/test/

# Otros
.env
*.log
