# ============================================================
# Cinema Microservices — Variables de entorno (template)
# Copiar este archivo a .env y ajustar los valores
# NUNCA commitear el .env real a git
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_pass

# --- Auth Service ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/auth_db
DB_USERNAME=auth_user
DB_PASSWORD=auth_pass

# --- LavinMQ ---
LAVINMQ_DEFAULT_USER=admin
LAVINMQ_DEFAULT_PASS=admin123

# --- Valkey (Redis-compatible) ---
VALKEY_PASSWORD=valkey_pass
